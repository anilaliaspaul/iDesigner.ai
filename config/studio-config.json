{
  "studio_name": "iDesigner.ai",
  "brands_directory": "resources/brands",
  "shared_resources_directory": "resources/shared",
  "projects_directory": "output/projects",
  "default_export_formats": [
    "png",
    "pdf"
  ],
  "default_digital_dpi": 144,
  "print_dpi": 300,
  "image_generation": {
    "mode": "provider-adaptive",
    "preferred_provider": "auto",
    "never_embed_credentials": true
  },
  "canva": {
    "mcp_server_name": "canva",
    "remote_mcp_url": "https://api.canva.com/connect/v1/mcp",
    "prefer_brand_templates": true,
    "require_approval_before_committing_existing_design_edits": true
  },
  "iteration": {
    "preserve_previous_versions": true,
    "require_explicit_final_approval": true,
    "max_initial_concepts": 3
  },
  "design_quality": {
    "default_style": "minimalist-editorial",
    "reference_style_overrides_default": true,
    "reference_typography_overrides_brand_display_font": true,
    "visual_density": "adaptive-to-reference",
    "allow_unrequested_text": false,
    "allow_generated_logo": false,
    "allow_generated_replacement_for_supplied_assets": false,
    "require_official_logo_before_production": true,
    "require_asset_provenance_map": true,
    "require_reference_side_by_side_qa": true,
    "require_composite_integration_qa": true,
    "require_copy_verbatim": true,
    "supported_languages": [
      "en",
      "ml"
    ],
    "require_malayalam_shaping_review": true,
    "fail_on_sticker_like_composite": true,
    "avoid": [
      "random-floating-text",
      "fake-labels",
      "decorative-microcopy",
      "generic-ai-flourishes",
      "unrequested-icons",
      "crude-cutout-paste",
      "invented-logo-or-emblem",
      "generated-lookalike-for-supplied-asset",
      "wrong-reference-typography"
    ]
  },
  "design_capabilities": {
    "canva": {
      "enabled_when_connected": true,
      "primary_editable_renderer": true
    },
    "adobe_express_templates": {
      "enabled_when_connector_available": true,
      "require_explicit_template_selection": true
    },
    "canvas_design": true,
    "poster_design": true,
    "algorithmic_art": true,
    "brand_guidelines": true,
    "skill_collection_index": "skills/graphic-design-skills-collection/references/upstream-skill-catalog.md"
  }
}
